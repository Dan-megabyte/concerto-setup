[Unit]
Description=Weather Server
After=network.target

[Service]
Type=simple
User=concerto-admin
WorkingDirectory=/home/concerto-admin/weather/

ExecStart=/home/concerto-admin/weather/start.sh

# Send SIGINT (Ctrl+C) on stop
KillSignal=SIGINT

# If it doesn't exit in time, force kill
TimeoutStopSec=10
KillMode=control-group

# Restart if it crashes
Restart=on-failure

# Log stdout/stderr to journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target